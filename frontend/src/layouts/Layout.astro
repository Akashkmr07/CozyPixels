---
export interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "CozyPixels by Nikhil | Official 4K Wallpapers & App",
  description = "Official CozyPixels: Browse 900+ free minimalist 4K wallpapers in Catppuccin, Nord, and One Dark. Download the native Desktop App and Chrome Extension."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="IAOFE8RkkMrjqNBwZmjWrRemguhVa5URQ_JHlamUo_o" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href="https://cozypixels.eu.org/" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="cozypixels, nikhil, nikhil cozy pixels, official cozypixels, cozy pixels app, free 4k wallpapers, minimalist wallpapers, catppuccin wallpaper, nord wallpaper, one dark wallpaper, desktop app, chrome extension" />
    <meta name="author" content="Nikhil Yadav (@yadavnikhil03)" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cozypixels.eu.org/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://cozypixels.eu.org/og-image.png" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@yadavnikhil03" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cozypixels.eu.org/og-image.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="theme-color" content="#505b93" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://cozypixels.eu.org/#organization",
          "name": "CozyPixels",
          "url": "https://cozypixels.eu.org/",
          "logo": {
            "@type": "ImageObject",
            "@id": "https://cozypixels.eu.org/#logo",
            "url": "https://cozypixels.eu.org/favicon.svg",
            "caption": "CozyPixels Logo"
          },
          "sameAs": [
            "https://github.com/yadavnikhil03/CozyPixels"
          ]
        },
        {
          "@type": "Person",
          "@id": "https://cozypixels.eu.org/#person",
          "name": "Nikhil Yadav",
          "url": "https://github.com/yadavnikhil03",
          "sameAs": [
            "https://github.com/yadavnikhil03"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://cozypixels.eu.org/#website",
          "url": "https://cozypixels.eu.org/",
          "name": "CozyPixels",
          "description": "Curated collection of 900+ free minimalist and aesthetic 4K wallpapers for desktop and mobile, along with a dedicated Desktop App and Chrome Extension.",
          "publisher": {
            "@id": "https://cozypixels.eu.org/#organization"
          },
          "author": {
            "@id": "https://cozypixels.eu.org/#person"
          },
          "potentialAction": [
            {
              "@type": "SearchAction",
              "target": {
                "@type": "EntryPoint",
                "urlTemplate": "https://cozypixels.eu.org/?q={search_term_string}"
              },
              "query-input": "required name=search_term_string"
            }
          ]
        }
      ]
    }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
